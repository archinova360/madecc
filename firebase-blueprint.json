{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Construction projects being tracked",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "client": { "type": "string" },
        "status": { "type": "string", "enum": ["Planning", "In Progress", "Completed", "On Hold"] },
        "budget": { "type": "number" },
        "deadline": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "client", "status", "budget"]
    },
    "Contract": {
      "title": "Contract",
      "description": "Signed legal agreements",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "title": { "type": "string" },
        "signedDate": { "type": "string", "format": "date-time" },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["Active", "Terminated", "Fulfilled"] }
      },
      "required": ["projectId", "title", "amount"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Labor costs and material payments",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "recipientId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "enum": ["Labor", "Material", "Utility", "Other"] },
        "description": { "type": "string" }
      },
      "required": ["amount", "date", "type"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Staff and labor records",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "salary": { "type": "number" },
        "contact": { "type": "string" },
        "joinedDate": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "role"]
    },
    "Invoice": {
      "title": "Invoice",
      "description": "Sent to clients for billing",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "invoiceNumber": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["Draft", "Sent", "Paid", "Overdue"] }
      },
      "required": ["projectId", "invoiceNumber", "amount", "status"]
    },
    "Receipt": {
      "title": "Receipt",
      "description": "Digital receipts of construction cost",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date-time" },
        "imageUrl": { "type": "string" }
      },
      "required": ["label", "amount", "date"]
    },
    "Content": {
      "title": "Content",
      "description": "Web content like blog insights",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "excerpt": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["title", "content"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "Client reviews",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "content": { "type": "string" },
        "rating": { "type": "number" }
      },
      "required": ["name", "content"]
    }
  },
  "firestore": {
    "/projects": { "schema": "Project", "description": "Collection of projects" },
    "/contracts": { "schema": "Contract", "description": "Collection of signed contracts" },
    "/payments": { "schema": "Payment", "description": "Collection of financial transactions" },
    "/employees": { "schema": "Employee", "description": "Collection of employee records" },
    "/invoices": { "schema": "Invoice", "description": "Collection of invoices" },
    "/receipts": { "schema": "Receipt", "description": "Collection of digital receipts" },
    "/content": { "schema": "Content", "description": "Collection of web content / blog insights" },
    "/testimonials": { "schema": "Testimonial", "description": "Collection of client ratings and reviews" }
  }
}
